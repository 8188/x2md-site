---
import "../styles/global.css";
import { DEFAULT_ADSENSE_CLIENT, DEFAULT_ADSENSE_SCRIPT_BASE, DEFAULT_SITE_URL } from "../config/constants";

import Header from "../components/Header.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: "zh-CN" | "en-US";
	canonicalPath?: string;
	keywords?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	alternateLinks?: Array<{ hreflang: string; href: string }>;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title = "X2MD | Online Document to Markdown Converter",
	description = "X2MD supports converting DOCX, PDF, and PPTX to Markdown. Free online and desktop download for Windows.",
	lang = "en-US",
	canonicalPath = "/",
	keywords,
	noindex = false,
	ogType = "website",
	alternateLinks = [],
	structuredData,
} = Astro.props;

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || DEFAULT_ADSENSE_CLIENT;
const adsenseScriptSrc = import.meta.env.PUBLIC_ADSENSE_SCRIPT_SRC || `${DEFAULT_ADSENSE_SCRIPT_BASE}?client=${adsenseClient}`;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || DEFAULT_SITE_URL).replace(/\/+$/, "");
const canonicalUrl = siteUrl ? `${siteUrl}${canonicalPath}` : undefined;
const defaultOgImage = siteUrl ? `${siteUrl}/favicon.svg` : undefined;
const ogImage = import.meta.env.PUBLIC_OG_IMAGE || defaultOgImage;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";

const legalLinks = lang === "zh-CN" 
	? [
		{ href: "/zh/about", label: "关于我们" },
		{ href: "/zh/privacy", label: "隐私政策" },
		{ href: "/zh/terms", label: "服务条款" },
	]
	: [
		{ href: "/en/about", label: "About" },
		{ href: "/en/privacy", label: "Privacy" },
		{ href: "/en/terms", label: "Terms" },
	];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="baidu-site-verification" content="codeva-iL2qoloQzB" />
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		<meta name="robots" content={robotsContent} />
		<meta name="google-adsense-account" content={adsenseClient} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:locale" content={lang === "zh-CN" ? "zh_CN" : "en_US"} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		{ogImage ? <meta property="og:image" content={ogImage} /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		{
			alternateLinks.map((link) => (
				<link rel="alternate" hreflang={link.hreflang} href={siteUrl ? `${siteUrl}${link.href}` : link.href} />
			))
		}
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=IBM+Plex+Sans:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		{adsenseScriptSrc ? <script async src={adsenseScriptSrc} crossorigin="anonymous"></script> : null}
		<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js" defer></script>
		<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.birds.min.js" defer></script>
		{
			structuredData ? (
				<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
			) : null
		}
		<title>{title}</title>
	</head>
	<body>
		<div id="vanta-bg" aria-hidden="true"></div>
		<Header lang={lang} />
		<slot />
		
		<footer class="site-footer">
			<div class="footer-container">
				<div class="footer-info">
					<p>© {new Date().getFullYear()} X2MD. All rights reserved.</p>
					<p class="footer-tagline">Stabilized and efficient Document to Markdown solution.</p>
				</div>
				<nav class="footer-nav">
					{legalLinks.map(link => (
						<a href={link.href}>{link.label}</a>
					))}
				</nav>
			</div>
		</footer>

		<style is:global>
			.site-footer {
				margin-top: 4rem;
				border-top: 1px solid var(--border);
				padding: 2.5rem 0;
				background: rgba(255, 252, 245, 0.5);
				position: relative;
				z-index: 2;
			}
			.footer-container {
				max-width: 1180px;
				margin: 0 auto;
				padding: 0 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.footer-info p {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.9rem;
			}
			.footer-tagline {
				opacity: 0.8;
				font-size: 0.8rem !important;
				margin-top: 0.3rem !important;
			}
			.footer-nav {
				display: flex;
				gap: 1.5rem;
			}
			.footer-nav a {
				text-decoration: none;
				font-size: 0.9rem;
				color: var(--ink-soft);
				transition: color 0.2s;
			}
			.footer-nav a:hover {
				color: var(--brand);
			}
			@media (max-width: 640px) {
				.footer-container {
					flex-direction: column;
					text-align: center;
				}
			}
		</style>

		<script>
			(function initVantaBirds() {
				const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				const lowPower = (navigator.hardwareConcurrency || 4) <= 4;
				const smallScreen = window.innerWidth < 992;
				if (reducedMotion || lowPower || smallScreen) return;

				let effect = null;
				const mount = () => {
					if (effect || !window.VANTA || !window.VANTA.BIRDS) return;
					effect = window.VANTA.BIRDS({
						el: "#vanta-bg",
						mouseControls: true,
						touchControls: true,
						gyroControls: false,
						minHeight: 200.0,
						minWidth: 200.0,
						scale: 1.0,
						scaleMobile: 1.0,
					});
				};

				window.addEventListener("load", mount, { once: true });
				setTimeout(mount, 1000);

				window.addEventListener("beforeunload", () => {
					if (effect) effect.destroy();
				});
			})();
		</script>
	</body>
</html>
