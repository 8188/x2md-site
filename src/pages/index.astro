---
import {
  LANG_STORAGE_KEY,
  DEFAULT_ADSENSE_CLIENT,
  DEFAULT_ADSENSE_SCRIPT_BASE,
} from "../config/constants";

const langStorageKey = LANG_STORAGE_KEY;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || DEFAULT_ADSENSE_CLIENT;
const adsenseScriptSrc =
  import.meta.env.PUBLIC_ADSENSE_SCRIPT_SRC ||
  `${DEFAULT_ADSENSE_SCRIPT_BASE}?client=${adsenseClient}`;
const alternateLinks = [
  { hreflang: "en", href: "/en/" },
  { hreflang: "zh-CN", href: "/zh/" },
  { hreflang: "x-default", href: "/en/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <title>X2MD</title>
    {
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    {adsenseScriptSrc ? <script async src={adsenseScriptSrc} crossorigin="anonymous"></script> : null}
    <script define:vars={{ langStorageKey }}>
      (function redirectByLocale() {
        const storageKey = langStorageKey;
        const query = new URLSearchParams(window.location.search);
        const fromQuery = query.get("lang");
        const saved = window.localStorage.getItem(storageKey);
        const detected = (fromQuery || saved || navigator.language || "en").toLowerCase();

        const target = detected.startsWith("zh") ? "/zh/" : "/en/";
        if (fromQuery === "zh" || fromQuery === "en") {
          window.localStorage.setItem(storageKey, fromQuery);
        }

        window.location.replace(target);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting...</p>
    <p><a href="/zh/">中文</a> | <a href="/en/">English</a></p>
  </body>
</html>
