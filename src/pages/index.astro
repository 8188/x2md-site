---
import {
  LANG_STORAGE_KEY,
  DEFAULT_ADSENSE_CLIENT,
  DEFAULT_ADSENSE_SCRIPT_BASE,
  DEFAULT_SITE_URL,
} from "../config/constants";

const langStorageKey = LANG_STORAGE_KEY;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || DEFAULT_ADSENSE_CLIENT;
const adsenseScriptSrc =
  import.meta.env.PUBLIC_ADSENSE_SCRIPT_SRC ||
  `${DEFAULT_ADSENSE_SCRIPT_BASE}?client=${adsenseClient}`;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || DEFAULT_SITE_URL).replace(/\/+$/, "");
const canonicalUrl = `${siteUrl}/`;
const title = "X2MD | Online Document to Markdown Converter";
const description =
  "Convert DOCX, PPTX, PDF and more to Markdown online. Download X2MD desktop EXE for offline conversion.";
const ogImage = `${siteUrl}/favicon.svg`;
const alternateLinks = [
  { hreflang: "en", href: "/en/" },
  { hreflang: "zh-CN", href: "/zh/" },
  { hreflang: "x-default", href: "/en/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="document to markdown, markdown converter, docx to markdown, pptx to markdown, x2md" />
    <meta name="robots" content="index, follow" />
    <meta name="google-adsense-account" content={adsenseClient} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    {
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={`${siteUrl}${link.href}`} />
      ))
    }
    {adsenseScriptSrc ? <script async src={adsenseScriptSrc} crossorigin="anonymous"></script> : null}
    <script define:vars={{ langStorageKey }}>
      (function redirectByLocale() {
        const storageKey = langStorageKey;
        const query = new URLSearchParams(window.location.search);
        const fromQuery = query.get("lang");
        const saved = window.localStorage.getItem(storageKey);
        const detected = (fromQuery || saved || navigator.language || "en").toLowerCase();

        const target = detected.startsWith("zh") ? "/zh/" : "/en/";
        if (fromQuery === "zh" || fromQuery === "en") {
          window.localStorage.setItem(storageKey, fromQuery);
        }

        window.location.replace(target);
      })();
    </script>
  </head>
  <body>
    <p>Redirecting...</p>
    <p><a href="/zh/">中文</a> | <a href="/en/">English</a></p>
  </body>
</html>
