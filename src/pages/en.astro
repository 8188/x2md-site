---
import ConverterPanel from "../components/ConverterPanel";
import DownloadPanel from "../components/DownloadPanel";
import { CONTACT_EMAIL, PRICING_PLANS, DEFAULT_SITE_URL } from "../config/constants";
import Layout from "../layouts/Layout.astro";

const creemBasic = import.meta.env.PUBLIC_CREEM_BASIC_URL || "#";
const creemPro = import.meta.env.PUBLIC_CREEM_PRO_URL || "#";
const creemLifetime = import.meta.env.PUBLIC_CREEM_LIFETIME_URL || "#";
const checkoutUrls = [creemBasic, creemPro, creemLifetime];
const plans = PRICING_PLANS.map((plan, index) => ({
  ...plan,
  checkoutUrl: checkoutUrls[index] || "#",
}));

const alternateLinks = [
  { hreflang: "en", href: "/en/" },
  { hreflang: "zh-CN", href: "/zh/" },
  { hreflang: "x-default", href: "/en/" },
];
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || DEFAULT_SITE_URL).replace(/\/+$/, "");

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "X2MD",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Windows",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      description: "Free online conversion forever, plus downloadable desktop app for better experience.",
    },
    description: "Convert documents to Markdown online forever for free, with desktop EXE for faster and more stable workflows.",
    inLanguage: "en-US",
    url: `${siteUrl}/en/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "en-US",
    mainEntity: [
      {
        "@type": "Question",
        name: "Is online conversion free to use?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Online conversion is free to use long-term.",
        },
      },
      {
        "@type": "Question",
        name: "How soon after payment will I get a key?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "License keys are usually delivered by email within 2 minutes.",
        },
      },
      {
        "@type": "Question",
        name: "How is my data handled?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The service does not store your file information.",
        },
      },
    ],
  },
];
---

<Layout
  lang="en-US"
  title="X2MD | Online Document and Markdown Converter"
  description="Convert DOCX, PPTX, PDF and more to Markdown, and convert Markdown to DOCX/PDF. Download Windows EXE for a better conversion experience."
  canonicalPath="/en/"
  keywords="document to markdown, markdown converter, docx to markdown, pptx to markdown, markdown formatter, x2md"
  alternateLinks={alternateLinks}
  structuredData={structuredData}
>
  <main class="page-wrap">
    <section class="hero reveal">
      <div class="hero-grid">
        <div>
          <span class="hero-badge">Free Online Forever · Desktop for Better Experience</span>
          <h1>Convert between documents and Markdown in one click.</h1>
          <p>
            X2MD converts DOCX, PPTX, Excel, and more. Use online conversion for free, and download desktop EXE for faster,
            offline, and batch workflows.
          </p>
          <div class="action-row">
            <a class="btn btn-primary btn-pulse-once" href="#convert">Start Converting</a>
            <a class="btn btn-ghost" href="#download">Download EXE</a>
          </div>
          <div class="hero-stats">
            <div class="stat"><strong>Forever Free</strong>online conversion available anytime</div>
            <div class="stat"><strong>Desktop EXE</strong>better speed, offline use, and batching</div>
            <div class="stat"><strong>14+ formats</strong>planned in phased rollout</div>
          </div>
        </div>
        <div class="surface" style="padding: 1rem; align-self: start;">
          <h3 style="margin-top: 0">How It Works</h3>
          <ol style="margin: 0; padding-left: 1.1rem; color: var(--ink-soft)">
            <li>Upload and preview conversions instantly</li>
            <li>Download desktop app (GUI or CLI) for offline use</li>
            <li>Pick a plan and pay via Creem</li>
            <li>Payment successful -> license key auto-emailed</li>
          </ol>
        </div>
      </div>
    </section>

    <section id="convert">
      <ConverterPanel client:load lang="en-US" />
    </section>

    <section id="download">
      <DownloadPanel client:load lang="en-US" />
    </section>

    <section class="surface section reveal" style="animation-delay: 320ms;" id="pricing">
      <h2>License Plans</h2>
      <p style="margin-top: 0; color: var(--ink-soft)">
        Plans differ by validity period and number of bindable devices. A license key is emailed automatically after payment.
      </p>
      <div class="plan-grid">
        {
          plans.map((plan) => (
            <article class={`plan${plan.highlight ? " plan-highlight" : ""}`}>
              {plan.highlight ? <span class="plan-badge">Recommended</span> : null}
              <h3>{plan.name_en}</h3>
              <div class="price-row">
                <span class="price-old">${plan.price_old}</span>
                <span class="price">${plan.price}</span>
              </div>
              <ul>
                <li>{plan.days > 0 ? `${plan.days}-day validity` : "Perpetual validity"}</li>
                <li>{`${plan.devices} device binding${plan.devices > 1 ? "s" : ""}`}</li>
                <li>Automatic email delivery</li>
              </ul>
              <a class={`btn ${plan.highlight ? "btn-primary" : "btn-ghost"}`} href={plan.checkoutUrl} target="_blank" rel="noreferrer">Buy Now</a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="surface section reveal" style="animation-delay: 380ms;">
      <h2>FAQ</h2>
      <div style="display: grid; gap: 0.7rem; color: var(--ink-soft)">
        <div><strong>Is online conversion free to use?</strong> Yes, online conversion is free to use long-term.</div>
        <div><strong>How soon after payment will I get a key?</strong> Usually within 2 minutes by email.</div>
        <div><strong>How is my data handled?</strong> We never store your file information.</div>
        <div><strong>Questions?</strong> Contact us at <a href={`mailto:${CONTACT_EMAIL}`} style="color: var(--brand); text-decoration: none; font-weight: 500;">{CONTACT_EMAIL}</a></div>
      </div>
    </section>

    <footer class="footer">
      (c) {new Date().getFullYear()} X2MD. Fast document conversion to Markdown, stable output, clear licensing.
    </footer>
  </main>
</Layout>

