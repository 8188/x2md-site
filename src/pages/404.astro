---
import Layout from "../layouts/Layout.astro";

const alternateLinks = [
  { hreflang: "en", href: "/en/" },
  { hreflang: "zh-CN", href: "/zh/" },
  { hreflang: "x-default", href: "/en/" },
];
---

<Layout
  lang="en-US"
  title="404 | X2MD"
  description="Page not found. Go back to X2MD home and continue converting documents to Markdown."
  canonicalPath="/404/"
  noindex={true}
  alternateLinks={alternateLinks}
>
  <main class="page-wrap">
    <section class="surface section" style="margin-top: 3rem;">
      <h1>Page Not Found</h1>
      <p style="color: var(--ink-soft);">
        The page you requested does not exist or has moved.
      </p>
      <div class="action-row">
        <a class="btn btn-primary" href="/en/">Go to English Home</a>
        <a class="btn btn-ghost" href="/zh/">前往中文首页</a>
      </div>
    </section>
  </main>
</Layout>
